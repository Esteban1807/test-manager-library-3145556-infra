# Copy to .env and fill in. The real .env is never committed (constitution Article IX).

# Database engine (starts empty: the API migrations create the schema)
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=

# API secrets
# APP_KEY: run `php artisan key:generate --show` in the api repo
APP_KEY=
# JWT_SECRET: run `php -r "echo bin2hex(random_bytes(32));"`
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Ports on the host
API_PORT=8000
APP_PORT=5173

# Demo only: lets the seeder in `tool` create overdue loans. Keep false outside demos.
LIBRARY_DEMO_CLOCK=false

# Sibling repositories (defaults assume the six repos are cloned side by side)
# API_PATH=../test-manager-library-3145556-api
# APP_PATH=../test-manager-library-3145556-app
